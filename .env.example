# ============================================================
# ESPACIO AUDITORIUM — Variables de entorno
#
# Local:  copiá este archivo como .env.local y completá los valores
#         (.env.local está en .gitignore; NUNCA se commitea).
# Vercel: Settings > Environment Variables. Marcá cada una en los
#         entornos que corresponda (Production / Preview).
#
# Regla de oro: las variables con prefijo VITE_ se EMPAQUETAN en el
# bundle del navegador y son públicas. Nunca pongas un secreto en una
# variable VITE_*. (Nunca existió ni debe existir VITE_ADMIN_PASSWORD.)
#
# Todas las variables listadas acá son leídas por api/ o src/. Si una
# variable no figura acá, el código no la usa: borrala de Vercel.
# ============================================================


# ------------------------------------------------------------
# SUPABASE (base de datos) — sólo backend
# ------------------------------------------------------------
# URL del proyecto (Settings > API > Project URL).
# Compatibilidad: si SUPABASE_URL no está, el backend usa VITE_SUPABASE_URL.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clave service_role (Settings > API). Salta RLS: SECRETA, sólo en funciones api/.
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------
# MERCADO PAGO (seña online)
# ------------------------------------------------------------
# Access Token de PRODUCCIÓN de la aplicación (Mercado Pago Developers > Tu app > Credenciales).
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tu app > Webhooks > "Clave secreta"). Con ella se
# verifica la firma x-signature de cada notificación. OBLIGATORIA en producción:
# sin ella el webhook loguea un error y sólo confía en re-consultar el pago.
MP_WEBHOOK_SECRET=
# Sólo para probar con credenciales de test: acepta pagos con live_mode=false.
# En producción dejar vacío o "false".
MP_ALLOW_TEST_PAYMENTS=false


# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
# URL pública del sitio, sin barra final. Se usa para back_urls y
# notification_url de Mercado Pago y para los links de los emails.
# Tiene que ser el host canónico (www): el apex redirige con 308 y
# Mercado Pago no sigue redirects en el webhook.
APP_URL=https://www.espacioauditorium.com.ar
# (Frontend, opcional) misma URL para el bundle del navegador.
VITE_APP_URL=https://www.espacioauditorium.com.ar


# ------------------------------------------------------------
# GOOGLE (Calendar + Sheets de leads) — Service Account
# ------------------------------------------------------------
# ID del calendario del espacio (normalmente el email de la cuenta).
# El calendario tiene que estar compartido con la service account con
# permiso "Hacer cambios en eventos".
GOOGLE_CALENDAR_ID=espacioauditorium@gmail.com
# Opción 1 (recomendada): el JSON completo de la service account en UNA línea.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
# Opción 2 (alternativa, sólo si no usás el JSON): email + private_key con los \n escapados.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...@....iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# ID de la planilla de Google Sheets donde el bot de WhatsApp registra leads
# (el ID largo de la URL). Hoja "Leads". Compatibilidad: también se lee GOOGLE_SHEET_ID.
GOOGLE_LEADS_SHEET_ID=


# ------------------------------------------------------------
# EMAIL (Gmail SMTP vía Nodemailer)
# ------------------------------------------------------------
# Cuenta que envía y recibe las notificaciones del negocio.
EMAIL_USER=espacioauditorium@gmail.com
# App Password de Google (Cuenta > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones).
# No es la contraseña de la cuenta. 16 caracteres, con o sin espacios.
EMAIL_APP_PASSWORD=


# ------------------------------------------------------------
# WHATSAPP DEL NEGOCIO
# ------------------------------------------------------------
# Número humano al que se deriva (formato internacional sin +). Se usa en
# emails, en el bot y en la página de error. Default: 5491138255877.
HUMAN_WHATSAPP_NUMBER=5491138255877
# Aviso de "nueva reserva" por CallMeBot (opcional; si faltan, no se envía).
# Alta: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=5491138255877
CALLMEBOT_APIKEY=


# ------------------------------------------------------------
# BOT DE WHATSAPP (Meta Cloud API oficial + Grok) — /api/whatsapp-meta
# Reemplaza al bot de Twilio. Comparte lógica en api/_wa-core.js.
# Webhook a configurar en Meta: https://www.espacioauditorium.com.ar/api/whatsapp-meta
# ------------------------------------------------------------
# Texto libre que inventás vos; se repite en Meta > WhatsApp > Configuración > Webhook.
WA_VERIFY_TOKEN=
# App secret de la app de Meta (Configuración de la app > Básica). Valida la firma
# X-Hub-Signature-256. OBLIGATORIO: sin él el webhook rechaza todo (falla cerrado).
META_APP_SECRET=
# Token PERMANENTE de un usuario del sistema (Business Settings > Usuarios del sistema),
# con permisos whatsapp_business_messaging y whatsapp_business_management.
WA_ACCESS_TOKEN=
# Phone number ID del número del bot (WhatsApp > Configuración de la API). No es el teléfono.
WA_PHONE_NUMBER_ID=
# Versión de la Graph API.
WA_GRAPH_VERSION=v23.0
# Grok (console.x.ai). Si falta, usa Claude (ANTHROPIC_API_KEY).
XAI_API_KEY=
XAI_MODEL=grok-4
# xai | anthropic. Default: xai si hay XAI_API_KEY. El otro (si está configurado) es respaldo.
WA_LLM_PROVIDER=
# Número del equipo que recibe los avisos de lead (con prefijo "whatsapp:").
TEAM_WHATSAPP_TO=whatsapp:+5491138255877
# Claude (console.anthropic.com): respaldo si Grok falla, o principal si no hay XAI_API_KEY.
ANTHROPIC_API_KEY=
# Avisos al equipo: siempre por mail (EMAIL_USER) y por WhatsApp a TEAM_WHATSAPP_TO.
# Fuera de la ventana de 24 h el WhatsApp sólo sale con una plantilla Utility aprobada
# de 1 variable (ej. "alerta_lead"). Vacío = sólo mail + intento de texto libre.
WA_TEAM_ALERT_TEMPLATE=
# Seguimiento automático (cron diario). Apagado hasta poner true y tener la plantilla
# Marketing aprobada (1 variable = nombre), ej. "seguimiento_consulta".
WA_FOLLOWUP_ENABLED=false
# Números a ignorar sin responder ni gastar IA (separados por coma, con código de país). Ya vienen 3 fijos en el código.
WA_BLOCKED_NUMBERS=
WA_TEMPLATE_FOLLOWUP=


# ------------------------------------------------------------
# PANEL ADMIN (/admin) — sólo backend
# ------------------------------------------------------------
# Contraseña del panel. Larga y única (generá una con: openssl rand -base64 24).
ADMIN_PASSWORD=
# Secreto con el que se firman los tokens de sesión del admin (12 h).
# Si no está, se deriva de ADMIN_PASSWORD; conviene setearlo aparte.
# Generar con: openssl rand -hex 32
ADMIN_SESSION_SECRET=


# ------------------------------------------------------------
# CRONS (send-reminders, payment-reminder, auto-cancel, keep-alive)
# ------------------------------------------------------------
# Vercel manda "Authorization: Bearer <CRON_SECRET>" en cada ejecución.
# OBLIGATORIO: sin él los crons rechazan toda llamada (falla cerrado).
# Generar con: openssl rand -hex 32
CRON_SECRET=


# ------------------------------------------------------------
# CUPONES Y ANTI-BOT (opcionales)
# ------------------------------------------------------------
# Cupones de descuento sobre la SEÑA, JSON {"CODIGO": porcentaje}.
# Vacío o "{}" = sin cupones. Ejemplo: {"AMIGOS10":10,"EMPRESA20":20}
COUPON_CODES={}
# Cloudflare Turnstile (https://dash.cloudflare.com > Turnstile). Si la secret
# está vacía, el formulario de reserva no exige captcha.
TURNSTILE_SECRET_KEY=
# (Frontend) Site key pública del mismo widget. Se empaqueta en el bundle.
VITE_TURNSTILE_SITE_KEY=
